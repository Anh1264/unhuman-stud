# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database (PGlite data directory — rebuild with: npm run seed)
/.data/

# original Midjourney masters (~60 MB). Kept out of git to stay lightweight;
# only needed to re-run `npm run media`. Back these up separately.
/assets-source/

# The 4K master: a local archive, far too large for git, rebuilt any time by
# `npm run media` from assets-source. It is NOT what the site plays — the 1080p
# encode beside it (public/videos/nu-ceasefire-1080.mp4) is, and that one is
# committed, because it is what gets deployed.
/public/videos/nu-ceasefire.mp4
